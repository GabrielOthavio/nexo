# Copie para .env e preencha.

# Banco PRÓPRIO do sync-backend — separado do banco do Django.
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/controladoria_sync?schema=public"

# Segredo do JWT (12 h). Gere:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SYNC_JWT_SECRET="troque-por-um-segredo-gerado"

# Onde o núcleo Django está rodando.
DJANGO_API_BASE_URL="http://127.0.0.1:8000"

# Segredo da API interna. Tem que ser IDÊNTICO ao MOBILE_SYNC_API_KEY em
# Controladoria/config/.env — e o IP deste serviço precisa estar em
# MOBILE_SYNC_ALLOWED_IPS lá (ou a lista lá estar vazia).
MOBILE_SYNC_API_KEY="troque-pelo-mesmo-segredo-do-django"

PORT=3333
