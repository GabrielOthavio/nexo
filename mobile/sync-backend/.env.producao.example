# PRODUÇÃO (VPS Ubuntu) — copie para .env no servidor e preencha.

SYNC_DATABASE_URL="postgresql://controladoria:<senha forte>@localhost:5432/controladoria_sync?schema=public"

# Gere na VM:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SYNC_JWT_SECRET="<gere na VM>"

# Django na MESMA VM — loopback, não passa pelo nginx nem sai da máquina.
DJANGO_API_BASE_URL="http://127.0.0.1:8000"

# IDÊNTICO ao MOBILE_SYNC_API_KEY do .env do Django.
MOBILE_SYNC_API_KEY="<o mesmo dos dois lados>"

PORT=3333
# Só o nginx alcança este serviço. Não exponha a 3333 à internet.
SYNC_HOST=127.0.0.1
