# Copie para config/.env e preencha. O servidor recusa subir sem SECRET_KEY,
# FIELD_ENCRYPTION_KEY e MOBILE_SYNC_API_KEY.
#
# Gere as três chaves de uma vez (com o venv ativo):
#   python -c "from django.core.management.utils import get_random_secret_key as k; from cryptography.fernet import Fernet; import secrets; print('SECRET_KEY=' + repr(k())); print('FIELD_ENCRYPTION_KEY=' + repr(Fernet.generate_key().decode())); print('MOBILE_SYNC_API_KEY=' + repr(secrets.token_urlsafe(32)))"

SECRET_KEY='troque-por-uma-chave-gerada'
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Chave Fernet (django-encrypted-model-fields). Cifra CPF, telefone, endereço
# e a descrição do Achado. PERDER ESTA CHAVE = dados ilegíveis para sempre.
FIELD_ENCRYPTION_KEY='troque-por-uma-chave-fernet-gerada'

# Segredo da API interna consumida pelo sync-backend (mobile/sync-backend).
# Tem que ser IDÊNTICO ao MOBILE_SYNC_API_KEY do .env de lá.
MOBILE_SYNC_API_KEY='troque-por-um-segredo-gerado'
# IPs de onde o sync-backend chama a API interna. Vazio = sem restrição de IP.
MOBILE_SYNC_ALLOWED_IPS=127.0.0.1

# sqlite: sem servidor de banco (desenvolvimento). postgresql: usa DB_* abaixo.
DB_ENGINE=sqlite

DB_NAME=controladoria_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
