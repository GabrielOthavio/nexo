# PRODUÇÃO (VPS Ubuntu) — copie para config/.env no servidor e preencha.
# NUNCA reaproveite as chaves de desenvolvimento: gere novas na VM com
#   python -c "from django.core.management.utils import get_random_secret_key as k; from cryptography.fernet import Fernet; import secrets; print('SECRET_KEY=' + repr(k())); print('FIELD_ENCRYPTION_KEY=' + repr(Fernet.generate_key().decode())); print('MOBILE_SYNC_API_KEY=' + repr(secrets.token_urlsafe(32)))"

SECRET_KEY='<gere na VM>'

# ATENÇÃO À ORDEM: só mude para False DEPOIS que o certbot emitir o
# certificado. Com DEBUG=False o Django liga SECURE_SSL_REDIRECT e HSTS de
# 1 ano — sem TLS no lugar, o site entra em loop de redirect e o navegador
# passa a recusar HTTP naquele domínio pelos 12 meses seguintes.
DEBUG=False

# 127.0.0.1 NÃO é opcional: o sync-backend chama a API interna do Django em
# http://127.0.0.1:8000, e o Django valida o Host de TODA requisição contra
# esta lista — inclusive as que nunca saíram da máquina. Sem ele, o site
# funciona normalmente e só o push do app quebra, com 400 e sem pista.
ALLOWED_HOSTS=seu-dominio.com,127.0.0.1,localhost

# Chave Fernet dos campos cifrados (CPF, telefone, endereço, descrição do
# Achado). GUARDE UM BACKUP FORA DO SERVIDOR: perdê-la torna esses dados
# ilegíveis para sempre — não há recuperação.
FIELD_ENCRYPTION_KEY='<gere na VM>'

# Segredo da API interna. Precisa ser IDÊNTICO ao MOBILE_SYNC_API_KEY do
# .env do sync-backend.
MOBILE_SYNC_API_KEY='<gere na VM — o mesmo dos dois lados>'
# Django e sync-backend na MESMA VM: a API interna nunca sai do loopback.
MOBILE_SYNC_ALLOWED_IPS=127.0.0.1

DB_ENGINE=postgresql
DB_NAME=controladoria_db
# Usuário dedicado da aplicação — NÃO use o superusuário 'postgres'.
DB_USER=controladoria
DB_PASSWORD='<senha forte>'
DB_HOST=localhost
DB_PORT=5432
